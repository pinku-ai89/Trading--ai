<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Trading AI</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0b1220;
      color: white;
    }

    .container {
      max-width: 700px;
      margin: auto;
      padding: 20px;
    }

    h1 {
      text-align: center;
      color: #00ff99;
      margin-top: 20px;
    }

    .subtitle {
      text-align: center;
      color: #b8c2d1;
      margin-bottom: 25px;
    }

    .box {
      background: #111c30;
      border-radius: 15px;
      padding: 20px;
      box-shadow: 0 0 20px rgba(0,255,153,0.15);
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-size: 16px;
    }

    textarea {
      width: 100%;
      min-height: 130px;
      padding: 15px;
      border-radius: 10px;
      border: 1px solid #30405c;
      background: #09111f;
      color: white;
      font-size: 16px;
      resize: vertical;
      outline: none;
    }

    textarea:focus {
      border-color: #00ff99;
    }

    button {
      width: 100%;
      margin-top: 15px;
      padding: 15px;
      border: none;
      border-radius: 10px;
      background: #00c878;
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #00a965;
    }

    .answer {
      margin-top: 20px;
      padding: 15px;
      min-height: 80px;
      background: #09111f;
      border: 1px solid #30405c;
      border-radius: 10px;
      line-height: 1.6;
    }

    .warning {
      color: #ffd166;
      font-size: 14px;
      margin-top: 15px;
      text-align: center;
    }
  </style>
</head>

<body>

  <div class="container">

    <h1>🤖 Trading AI</h1>

    <p class="subtitle">
      AI Trading Analysis Assistant
    </p>

    <div class="box">

      <label for="question">
        আপনার ট্রেডিং প্রশ্ন লিখুন:
      </label>

      <textarea
        id="question"
        placeholder="যেমন: XAUUSD 5 মিনিট চার্টে এখন Buy নাকি Sell?"
      ></textarea>

      <button onclick="askAI()">
        🔍 AI Analysis
      </button>

      <div class="answer" id="answer">
        এখানে AI-এর উত্তর দেখা যাবে।
      </div>

      <div class="warning">
        ⚠️ এটি শুধুমাত্র শিক্ষামূলক ট্রেডিং বিশ্লেষণের জন্য।
      </div>

    </div>

  </div>


  <script>

    function askAI() {

      const question = document.getElementById("question").value;
      const answer = document.getElementById("answer");

      if (question.trim() === "") {

        answer.innerHTML = "❗ আগে আপনার প্রশ্ন লিখুন।";

        return;
      }

      answer.innerHTML =
        "🤖 আপনার প্রশ্ন পেয়েছি।<br><br>" +
        "বর্তমানে AI সংযোগ করা হয়নি। " +
        "AI API সংযোগ করার পর এখানে আসল AI Trading Analysis দেখাবে।";

    }

  </script>

</body>
</html>
