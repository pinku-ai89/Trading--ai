
<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trading AI</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0b1220;
      color: white;
    }

    .header {
      padding: 20px;
      text-align: center;
      background: #111827;
      border-bottom: 1px solid #263244;
    }

    .header h1 {
      margin: 0;
      color: #22c55e;
      font-size: 30px;
    }

    .header p {
      margin: 8px 0 0;
      color: #9ca3af;
    }

    .container {
      max-width: 600px;
      margin: auto;
      padding: 20px;
    }

    .card {
      background: #111827;
      border-radius: 15px;
      padding: 20px;
      margin-top: 20px;
      border: 1px solid #263244;
    }

    .card h2 {
      margin-top: 0;
      color: #38bdf8;
    }

    .message {
      background: #1f2937;
      padding: 15px;
      border-radius: 10px;
      line-height: 1.6;
      color: #e5e7eb;
    }

    .input-area {
      display: flex;
      gap: 10px;
      margin-top: 15px;
    }

    input {
      flex: 1;
      padding: 14px;
      border: none;
      border-radius: 10px;
      background: #1f2937;
      color: white;
      font-size: 16px;
      outline: none;
    }

    button {
      padding: 14px 18px;
      border: none;
      border-radius: 10px;
      background: #22c55e;
      color: white;
      font-weight: bold;
      font-size: 16px;
    }

    .signal {
      display: flex;
      justify-content: space-between;
      margin-top: 15px;
      padding: 15px;
      background: #1f2937;
      border-radius: 10px;
    }

    .buy {
      color: #22c55e;
      font-weight: bold;
    }

    .sell {
      color: #ef4444;
      font-weight: bold;
    }

    .warning {
      margin-top: 20px;
      color: #9ca3af;
      font-size: 13px;
      text-align: center;
    }
  </style>
</head>

<body>

  <div class="header">
    <h1>🤖 Trading AI</h1>
    <p>Smart Trading Assistant</p>
  </div>

  <div class="container">

    <div class="card">
      <h2>AI Assistant</h2>

      <div class="message" id="answer">
        👋 স্বাগতম! Trading সম্পর্কে আপনার প্রশ্ন লিখুন।
      </div>

      <div class="input-area">
        <input
          type="text"
          id="question"
          placeholder="আপনার প্রশ্ন লিখুন..."
        >

        <button onclick="askAI()">Send</button>
      </div>
    </div>

    <div class="card">
      <h2>📊 Market Analysis</h2>

      <div class="signal">
        <span>XAUUSD</span>
        <span class="buy">WAIT</span>
      </div>

      <div class="signal">
        <span>Trend</span>
        <span>Analyzing...</span>
      </div>

      <div class="signal">
        <span>Risk</span>
        <span>High</span>
      </div>
    </div>

    <div class="warning">
      ⚠️ Trading involves risk. Always do your own analysis.
    </div>

  </div>

  <script>
    function askAI() {
      const question = document.getElementById("question").value;
      const answer = document.getElementById("answer");

      if (question.trim() === "") {
        answer.innerHTML = "❗ আগে আপনার প্রশ্ন লিখুন।";
        return;
      }

      answer.innerHTML =
        "🤖 আপনার প্রশ্ন পেয়েছি। আসল AI সংযোগ করার পর এখানে AI-এর উত্তর দেখা যাবে।";
    }
  </script>

</body>
</html>
